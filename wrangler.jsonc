{
  "name": "t5quantlab-site",
  "main": "src/runtime-worker.js",
  "compatibility_date": "2026-09-26",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "RUNTIME_LICENSE_PRODUCTS": "attack_completion_c_mt5_v2,trend_capture_mt5_v2,range_martingale_mt4_v2,range_aggressive_mt4_mt5_v2",
    "RUNTIME_LICENSE_V2_PRODUCTS": "attack_completion_c_mt5_v2,trend_capture_mt5_v2,range_martingale_mt4_v2,range_aggressive_mt4_mt5_v2",
    "AUTH_EMAIL_FROM": "T5 Quant Lab <login@t5quantlab.com>",
    "MARKETING_EMAIL_FROM": "T5 Quant Lab <updates@t5quantlab.com>",
    "PAYPAL_ENVIRONMENT": "live",
    "ENABLE_PAYPAL_SANDBOX_E2E": "false",
    "T5_TRAINING_DELIVERY_ENABLED": "true",
    "T5_TRAINING_LIVE_CHECKOUT": "true",
    "TRAINING_LAUNCH_ORDER_ID": "T5O-8612ed96fd25e60d4cf7",
    "T5_BUILDER_PASS_PRICE_USD_MINOR": "1490",
    "T5_INDICATOR_MEMBERSHIP_PRICE_USD_MINOR": "1390",
    "T5_PREMIUM_MEMBERSHIP_PRICE_USD_MINOR": "5990",
    "T5_BUILDER_PASS_PRICE_CNY_MINOR": "10008",
    "T5_INDICATOR_MEMBERSHIP_PRICE_CNY_MINOR": "9336",
    "T5_PREMIUM_MEMBERSHIP_PRICE_CNY_MINOR": "40232",
    "RUNTIME_SIGNED3_PRODUCTS": "structure_decision_map_mt4,mtf_structure_panel_mt4,neckline_mtf_mt4,progress_candle_mt4,attack_completion_c_mt5_v3,trend_capture_mt5_v3,range_martingale_mt4_v3,range_aggressive_mt4_mt5_v3"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "USER_CODE_BUCKET",
      "bucket_name": "t5quantlab-user-code"
    }
  ],
  "d1_databases": [
    {
      "binding": "BUILDER_DB",
      "database_name": "t5quantlab-builder",
      "database_id": "332c88ef-ecca-4c9b-a085-2cfea9228b4e"
    }
  ]
}
